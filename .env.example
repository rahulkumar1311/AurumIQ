# AurumIQ Environment Configuration
# Copy this file to .env to customize environment parameters

# Database path (defaults to backend/data/aurumiq.db if left unset)
AURUMIQ_DB_PATH=data/aurumiq.db

# Data directory path
AURUMIQ_DATA_DIR=data

# Allowed CORS origins (comma-separated, defaults to * for local development)
CORS_ORIGINS=*

# Optional Port configurations (defaults: Backend=8000, Frontend=5173)
PORT=8000

# Frontend API URL (for production builds, e.g. on Vercel)
VITE_API_URL=https://aurumiq-1.onrender.com
