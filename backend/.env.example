# AurumIQ Backend Environment Configuration
# Copy this file to .env in the backend folder or set in the operating system environment

# Database path (defaults to data/aurumiq.db if left unset)
AURUMIQ_DB_PATH=data/aurumiq.db

# Data directory path
AURUMIQ_DATA_DIR=data

# Allowed CORS origins (comma-separated, defaults to * for local development)
CORS_ORIGINS=*

# Backend port
PORT=8000
